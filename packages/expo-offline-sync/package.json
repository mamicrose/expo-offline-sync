{
  "name": "expo-offline-sync",
  "version": "1.0.0",
  "description": "Deterministic, scoped, engine-agnostic offline mutation & request queue for Expo & React Native with SQLite persistence, optimistic updates, and background sync.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "offline-first",
    "offline-sync",
    "mutation-queue",
    "sqlite",
    "optimistic-ui",
    "request-queue",
    "trpc",
    "graphql",
    "rest",
    "background-sync",
    "netinfo"
  ],
  "author": "mamicrose",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mamicrose/expo-offline-sync.git"
  },
  "bugs": {
    "url": "https://github.com/mamicrose/expo-offline-sync/issues"
  },
  "homepage": "https://github.com/mamicrose/expo-offline-sync#readme",
  "peerDependencies": {
    "@react-native-community/netinfo": ">=9.0.0",
    "expo-background-fetch": ">=12.0.0",
    "expo-sqlite": ">=14.0.0",
    "expo-task-manager": ">=12.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-background-fetch": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "expo-task-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.18",
    "@types/react-native": "^0.72.8",
    "jsdom": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "react-native": "^0.76.7",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
